{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invillage.com.tw/schemas/runtime-occurrences-v1.json",
  "title": "Invillage runtime asset occurrences",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceFiles",
    "summary",
    "assets",
    "externalAssets",
    "unmappedUrls"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^imports/webflow/site/(html|css)/"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalOccurrences",
        "uniqueAssetCount",
        "pagesAssetCount",
        "r2AssetCount",
        "genericExternalCount",
        "unmappedCount"
      ],
      "properties": {
        "totalOccurrences": {
          "type": "integer",
          "minimum": 139
        },
        "uniqueAssetCount": {
          "const": 139
        },
        "pagesAssetCount": {
          "const": 16
        },
        "r2AssetCount": {
          "const": 123
        },
        "genericExternalCount": {
          "type": "integer",
          "minimum": 2
        },
        "unmappedCount": {
          "const": 0
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 139,
      "maxItems": 139,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "placement",
          "category",
          "occurrences"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$"
          },
          "placement": {
            "enum": [
              "pages",
              "r2"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "occurrences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/occurrence"
            }
          }
        }
      }
    },
    "externalAssets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "originalUrl",
          "sourcePath",
          "context",
          "classification",
          "expectedAction"
        ],
        "properties": {
          "originalUrl": {
            "type": "string",
            "format": "uri"
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^imports/webflow/site/(html|css)/"
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "generic-pages",
              "allowed-third-party",
              "forbidden-webflow",
              "unknown"
            ]
          },
          "expectedAction": {
            "enum": [
              "localize-pages",
              "preserve-allowlist",
              "reject-network-dependency",
              "manual-review"
            ]
          }
        }
      }
    },
    "unmappedUrls": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "$defs": {
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "context",
        "attribute",
        "originalUrl",
        "descriptor"
      ],
      "properties": {
        "sourcePath": {
          "type": "string",
          "pattern": "^imports/webflow/site/(html|css)/"
        },
        "context": {
          "enum": [
            "html-attribute",
            "html-srcset",
            "css-url",
            "json-ld"
          ]
        },
        "attribute": {
          "type": "string",
          "minLength": 1
        },
        "originalUrl": {
          "type": "string",
          "format": "uri"
        },
        "descriptor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
