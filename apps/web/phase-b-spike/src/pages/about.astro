---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/secondary-pages.css';

/**
 * /about（關於莊園）
 *
 * 內容來源：apps/web/public/about.html（frozen copy 文字）
 *
 * 文案原則：
 * - 舊文案與既有事實照原文保留
 * - 「科技城 IOT 長照設備展示中心」定位僅在本頁呈現；只使用使用者提供的原句，
 *   不自行補寫設備功能或醫療效果
 * - 頁尾洽詢 CTA 為該頁唯一 Messenger 入口
 */

const messengerUrl = 'https://m.me/invillagewulai';
const pageTitle = '關於我們';
const heroImage = '/assets/secondary/mansion-night-001.jpg';
const heroImageAlt = '紅河隱園夜晚建築外觀：大面積落地窗透出室內燈光，藍調天空與林木包圍。';

type NearbyDetails = {
  address?: string;
  phone?: string;
  access?: string;
  infoUrl?: string;
  infoLabel?: string;
};

type AttractionCard = {
  id: string;
  title: string;
  body: string;
};

const attractions: AttractionCard[] = [
  {
    id: 'attraction-red-river-valley',
    title: '烏來紅河谷',
    body:
      '步行 3 分鐘即可到達，此地遊客不多，保留原始山林純粹的氣息，附近加九寮景觀大橋一帶，若天氣適宜，鼓勵貴賓趁著白天時間前往紅河谷步道走走，步道前段平緩，沿著加九寮溪畔平行前進可抵達加九寮天然滑水道，此地為極少數人知道的秘境。',
  },
  {
    id: 'attraction-old-street',
    title: '烏來老街、烏來台車、烏來瀑布、雲仙樂園',
    body:
      '開車大約五分鐘即達；公車 849 可到烏來老街一帶，老街主打原住民料理。可以體驗烏來台車搭至烏來瀑布，再搭纜車前往雲仙樂園遊玩。',
  },
  {
    id: 'attraction-neidong',
    title: '內洞遊樂區',
    body:
      '又稱為娃娃谷，從入口步行沿溪而行約 20 分鐘可以抵達三層瀑布。這裡是已知最多芬多精負離子含量最高的景點，須購票入場風景遊樂區。',
  },
  {
    id: 'attraction-fushan-butterfly',
    title: '福山/蝴蝶公園',
    body:
      '從紅河谷開車約 40 分鐘即可抵達。這條路線沿途都是大型峽谷，終點站是福山部落，從馬家堡餐廳旁步行到蝴蝶公園，這裡少為人知的台北秘境，也是北部的水源頭純淨清涼，走一圈大約 1 個小時返回停車處。',
  },
  {
    id: 'attraction-tonghou',
    title: '桶後溪/林物局復育地',
    body:
      '此地堪稱攝影師的後花園，全線沿溪的道路，終點站是林物局造林地，翻過一座山就是宜蘭縣。',
  },
];

type Recommendation = {
  id: string;
  name: string;
  body: string;
  category: '美食' | '溫泉';
};

const nearbyRecommendations: Recommendation[] = [
  {
    id: 'rec-niaolaibo',
    category: '美食',
    name: '鳥來伯餐廳',
    body:
      '單點小吃、辦桌菜便宜要事先預訂、菜色豐富又大碗。一桌5500元12個男人吃不完要打包。後方湖景優美宜拍照。路程約1.8公里。附近車位經常滿、用餐時間客人多，最好提早到店用餐。招牌菜土雞、炸鰻魚、炒飯等。',
  },
  {
    id: 'rec-yukoyu',
    category: '美食',
    name: '于烤魚',
    body: '用餐環境、菜色不錯。是歌手于冠華所經營。',
  },
  {
    id: 'rec-tai-chicken',
    category: '美食',
    name: '台雞店',
    body: '用餐空間大，在日月光溫泉附近，路邊停車方便，晚上比較早打烊需注意用餐時間。',
  },
  {
    id: 'rec-sunmoon',
    category: '溫泉',
    name: '日月光溫泉',
    body: '具露天風呂大坪數戶外空間，少數提供親子一起泡湯的溫泉會館（須著泳裝），男、女湯、湯屋也是選項。',
  },
  {
    id: 'rec-yunding',
    category: '溫泉',
    name: '雲頂溫泉',
    body: '半露天男女湯池環境不錯。',
  },
];

// 新增的到訪資訊；原景點／商家介紹文字保持不變。
const nearbyDetails: Record<string, NearbyDetails> = {
  'attraction-red-river-valley': {
    address: '新北市烏來區紅河谷',
    infoUrl: 'https://newtaipei.travel/zh-tw/attractions/detail/109893',
    infoLabel: '新北市觀光旅遊網',
  },
  'attraction-old-street': {
    infoUrl: 'https://newtaipei.travel/zh-tw/attractions/detail/110660',
    infoLabel: '烏來老街資訊',
  },
  'attraction-neidong': {
    address: '新北市烏來區信賢里娃娃谷46號',
    phone: '02-2661-7358',
    infoUrl: 'https://www.forest.gov.tw/0000182',
    infoLabel: '林業保育署',
  },
  'attraction-fushan-butterfly': {
    infoUrl: 'https://newtaipei.travel/zh-tw/news/detail/1605',
    infoLabel: '新北市觀光旅遊網',
  },
  'attraction-tonghou': {
    access: '汽、機車於林道 1K 處管制；自行車與行人可通行。',
    infoUrl: 'https://hsinchu.forest.gov.tw/ForestRoad/10003367',
    infoLabel: '桶后林道資訊',
  },
  'rec-niaolaibo': {
    address: '新北市烏來區堰堤13號1樓',
    phone: '02-2661-6060',
    infoUrl: 'https://blake.com.tw/blog/post/niaolaibo',
    infoLabel: '餐廳資訊',
  },
  'rec-yukoyu': {
    address: '新北市烏來區新烏路四段36號',
    phone: '02-2661-6263',
  },
  'rec-tai-chicken': {
    address: '新北市烏來區新烏路四段1號',
    phone: '02-2661-7711',
  },
  'rec-sunmoon': {
    address: '新北市烏來區新烏路四段18號',
    phone: '02-2661-6677',
  },
  'rec-yunding': {
    address: '新北市烏來區西羅岸路45號',
    phone: '02-2661-7755',
    infoUrl: 'https://cloudspring.com.tw/yun-ding/',
    infoLabel: '官方網站',
  },
};

const nearbyCards = [
  ...attractions.map((place) => ({
    id: place.id,
    name: place.title,
    body: place.body,
    category: '景點' as const,
    ...nearbyDetails[place.id],
  })),
  ...nearbyRecommendations.map((place) => ({
    id: place.id,
    name: place.name,
    body: place.body,
    category: place.category,
    ...nearbyDetails[place.id],
  })),
];
---

<SiteLayout title={pageTitle}>
  <main class="page-main secondary-page" id="main-content" tabindex="-1">
    <section class="secondary-page-hero" aria-labelledby="about-heading">
      <img src={heroImage} alt={heroImageAlt} width="1280" height="854" loading="eager" decoding="async" />
      <div class="secondary-page-hero-content">
        <h1 class="secondary-page-title" id="about-heading">{pageTitle}</h1>
        <p class="secondary-page-deck">
          夢想與分享，打造一座城堡靠的不是一個人的實力，而是一群人的努力。
        </p>
      </div>
    </section>

    <section class="secondary-section" aria-labelledby="about-story-heading">
      <div class="secondary-section-inner secondary-prose">
        <h2 class="secondary-section-heading" id="about-story-heading">夢想與分享</h2>
        <p>
          莊園 並非一方富賈獨有，而是平凡的你我至少片刻擁有。紅河隱園在七年半間點滴打造而成，累積20多年的技術成果在這裡呈現，這裡也是一個合作交流的平台，不同產業領域專長都可以巧妙的結合。
        </p>
        <p>歡迎帶著你的理想跟我們永續創造下去。</p>
      </div>
    </section>

    <figure class="secondary-figure">
      <img src="/assets/secondary/forest-night-walk-001.jpg" alt="紅河隱園夜晚林木步道：低燈光沿步道打亮樹幹，遠方為莊園建築輪廓。" width="1280" height="854" loading="lazy" decoding="async" />
    </figure>

    <section class="secondary-section" aria-labelledby="about-sustainability-heading">
      <div class="secondary-section-inner secondary-prose">
        <h2 class="secondary-section-heading" id="about-sustainability-heading">淨零排放&智慧科技</h2>
        <p>
          永續淨零排放在國內外企業機構佈局推行ESG永續發展路徑。身為小企業的我們也積極配合國家政策，共同為氣候變遷做些努力。小則從減少塑膠、降低耗能，大至改變生活習慣甚至帶動他人的觀念行為。我們先從節能減碳的運用做起，「紅河隱園 InVillage」將成為綠色生活科技的體驗場域。我們資源有限但是職志不變。一點一滴的不斷改善精進，為永續莊園而努力。
        </p>
        <p>
          淨零排放&智慧科技，帶來安全、健康、舒適、享受。除了解決生活中的困擾，我們運用「環境管理系統」來維護生活品質，並有效率地降低管理成本，減少人與環境彼此的衝突破壞。來這裡舒服地坐著讓您從視覺、呼吸、體感、心情自然融入並體驗智慧生活情境。
        </p>
      </div>
    </section>

    <section class="secondary-section" aria-labelledby="about-iot-heading">
      <div class="secondary-section-inner">
        <h2 class="secondary-section-heading" id="about-iot-heading">科技城 IoT 長照設備展示中心</h2>
        <p class="secondary-lede">
          紅河隱園另一個定位是：科技城 IOT 長照設備展示中心，能夠親自體驗最全面的設備。
        </p>
      </div>
    </section>

    <section class="secondary-section secondary-nearby-section" aria-labelledby="about-nearby-heading">
      <div class="secondary-section-inner">
        <h2 class="secondary-section-heading" id="about-nearby-heading">附近景點美食推薦</h2>
        <ul class="secondary-nearby-grid">
          {nearbyCards.map((place) => (
            <li>
              <article class="secondary-card secondary-nearby-card" id={place.id}>
                <div class="secondary-nearby-card-header">
                  <span class="secondary-nearby-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                      {place.category === '景點' && (
                        <>
                          <path d="M2 19h20M4 16.5l5-6 3 3 3.5-5 4.5 8" />
                          <path d="M12 9V3m0 2.5L9.5 4m2.5 1.5L14.5 4" />
                        </>
                      )}
                      {place.category === '美食' && (
                        <>
                          <path d="M3 19h18M5 16a7 7 0 0 1 14 0H5Zm7-7V7" />
                          <path d="M9 5.5l1.5 1M15 5.5l-1.5 1" />
                        </>
                      )}
                      {place.category === '溫泉' && (
                        <>
                          <path d="M6 3c-2 2 2 3 0 5m6-5c-2 2 2 3 0 5m6-5c-2 2 2 3 0 5" />
                          <path d="M3 14c3-1.5 5-1.5 8 0s5 1.5 10 0M3 19c3-1.5 5-1.5 8 0s5 1.5 10 0" />
                        </>
                      )}
                    </svg>
                  </span>
                  <div class="secondary-nearby-card-title">
                    <span class="secondary-nearby-category">{place.category}</span>
                    <h3>{place.name}</h3>
                  </div>
                </div>
                <p class="secondary-card-body">{place.body}</p>
                {(place.address || place.phone || place.access || place.infoUrl) && (
                  <dl class="secondary-nearby-meta">
                    {place.address && (
                      <div>
                        <dt>地址</dt>
                        <dd>{place.address}</dd>
                      </div>
                    )}
                    {place.phone && (
                      <div>
                        <dt>電話</dt>
                        <dd><a href={`tel:${place.phone.replace(/[^0-9]/g, '')}`}>{place.phone}</a></dd>
                      </div>
                    )}
                    {place.access && (
                      <div>
                        <dt>交通</dt>
                        <dd>{place.access}</dd>
                      </div>
                    )}
                    {place.infoUrl && place.infoLabel && (
                      <div>
                        <dt>資訊</dt>
                        <dd><a href={place.infoUrl} target="_blank" rel="noopener noreferrer">{place.infoLabel}</a></dd>
                      </div>
                    )}
                  </dl>
                )}
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="secondary-section" aria-labelledby="about-transport-heading">
      <div class="secondary-section-inner secondary-prose">
        <h2 class="secondary-section-heading" id="about-transport-heading">交通路線</h2>
        <p>
          紅河隱園位於新北烏來與新店的交界處，距離捷運新店站僅約 20 分鐘車程。地址是：新北市烏來區新烏路五段10-3號。
        </p>
        <ul class="secondary-prose-list">
          <li>開車：搜尋Google地圖「紅河隱園」，一路為你導引至門口。</li>
          <li>公車：849 路線公車大約15分鐘一班。從台北車站或是碧潭的新店總站都可以搭乘。我們建議搭捷運松山新店線，在新店總站下車，搭乘849路線公車，大約30~40分鐘車程在「成功站」下車，鄉園土雞城前右轉下坡步行大約5分鐘即可抵達。</li>
        </ul>
        <p>詳見「<a href="/contact">聯絡我們</a>」>「交通位置」。</p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="about-cta-heading">
      <div class="content-inner secondary-cta-section">
        <h2 class="section-heading" id="about-cta-heading">預訂紅河隱園 一日莊園主人</h2>
        <p>
          我們每次只接待一組貴賓，為了確保您的隱私與獨享莊園。白天可以盛裝打扮也適合休閒輕裝，夜裡三五好友、閨蜜私密自在，品嚐紅酒茗茶，您將不會受到打擾。
        </p>
        <p>
          本莊園是由科技城公司營運管理，這裡的空間租借、參觀體驗、分享發表、教育訓練、會議住宿等各項活動都歡迎各界預約洽詢合作。
        </p>
        <a class="primary-cta" href={messengerUrl} target="_blank" rel="noopener noreferrer">立刻洽詢</a>
      </div>
    </section>
  </main>
</SiteLayout>
