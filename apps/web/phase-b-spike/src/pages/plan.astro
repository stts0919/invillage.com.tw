---

<SiteLayout title={pageTitle}>
  <main class="page-main secondary-page" id="main-content" tabindex="-1">
    <section class="secondary-page-hero" aria-labelledby="plan-heading">
      <img src={heroImage} alt={heroImageAlt} width="1280" height="854" loading="eager" decoding="async" />
      <div class="secondary-page-hero-content">
        <h1 class="secondary-page-title" id="plan-heading">{pageTitle}</h1>
        <p class="secondary-page-deck">
          在紅河隱園，窗戶看出去都是森林峽谷。雖然沒有五星飯店的奢華裝修，卻不見對街嫌惡景觀、也沒有鄰房干擾隱私。在這裡只有舒適放鬆，獨享整個大自然空間。
        </p>
      </div>
    </section>

    <section class="secondary-section" aria-labelledby="plan-intro-heading">
      <div class="secondary-section-inner secondary-prose">
        <h2 class="secondary-section-heading" id="plan-intro-heading">
          離市區最近的莊園，多樣化的房型與訂房方案
        </h2>
        <p>離市區最近的莊園，我們提供多樣化的房型與訂房方案，家族旅遊、親友度假、公司會議活動。</p>
        <p>體驗當一次莊園的主人。</p>
        <p>預約制包場，體驗「智慧莊園」，一次只接待一組貴賓。</p>
      </div>
    </section>

    <figure class="secondary-figure">
      <img src="/assets/secondary/outdoor-patio-001.jpg" alt="紅河隱園戶外露台下午茶：藤椅與雙層點心架，背景為烏來峽谷綠山景。" width="1280" height="854" loading="lazy" decoding="async" />
    </figure>

    <section class="secondary-section" aria-labelledby="plan-list-heading">
      <div class="secondary-section-inner">
        <h2 class="secondary-section-heading" id="plan-list-heading">
          訂房方案總覽
        </h2>
        <ul class="secondary-plan-list">
          {plans.map((plan) => (
            <li>
              <details class="secondary-plan-card" name="plan-group">
                <summary>
                  <span class="secondary-plan-card-title">{plan.title}</span>
                  <span class="secondary-plan-card-rate">{plan.rateLabel}</span>
                </summary>
                <div class="secondary-plan-card-body">
                  <p class="secondary-plan-summary">{plan.blurb}</p>
                  <ul class="secondary-plan-detail-list">
                    {plan.notes.map((note) => <li>{note}</li>)}
                  </ul>
                  <div class="secondary-plan-subgrid">
                    {plan.cards.map((card) => (
                      <article class="secondary-plan-sub" id={card.id}>
                        <h4>{card.title}</h4>
                        <p class="secondary-plan-sub-rate"><strong>費用</strong>：{card.rate}</p>
                        <p><strong>時段</strong>：{card.scope}</p>
                        <ul class="secondary-plan-detail-list">
                          {card.details.map((line) => <li>{line}</li>)}
                        </ul>
                        <ul class="secondary-plan-detail-list">
                          {card.extras.map((extra) => (
                            <li><strong>{extra.label}</strong>：{extra.text}</li>
                          ))}
                        </ul>
                      </article>
                    ))}
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="secondary-section" aria-labelledby="plan-contact-info-heading">
      <div class="secondary-section-inner">
        <h2 class="secondary-section-heading" id="plan-contact-info-heading">服務洽詢資訊</h2>
        <ul class="secondary-contact-info">
          <li>
            <span class="secondary-contact-info-label">公司</span>
            <span>科技城股份有限公司</span>
          </li>
          <li>
            <span class="secondary-contact-info-label">地址</span>
            <span>新北市新店區中正路四維巷一弄四號四樓（遠東工業區）</span>
          </li>
          <li>
            <span class="secondary-contact-info-label">電話</span>
            <span>（02）22194201 分機 31</span>
          </li>
          <li>
            <span class="secondary-contact-info-label">手機</span>
            <span>0937017250</span>
          </li>
          <li>
            <span class="secondary-contact-info-label">承辦人</span>
            <span>曾先生</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="content-section" aria-labelledby="plan-cta-heading">
      <div class="content-inner secondary-cta-section">
